{
  "name": "recueil",
  "version": "1.0.0",
  "type": "module",
  "description": "self-hosted webpage bookmarker and archiver",
  "homepage": "https://github.com/mfinelli/recueil",
  "author": "Mario Finelli",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "prettier --check .",
    "check:www": "pnpm exec prettier --plugin=prettier-plugin-jinja-template --parser=jinja-template --ignore-path '.gitignore' --check 'www/**/*.html'",
    "dev": "vite",
    "fmt": "prettier --write .",
    "fmt:www": "pnpm exec prettier --plugin=prettier-plugin-jinja-template --parser=jinja-template --ignore-path '.gitignore' --write 'www/**/*.html'",
    "lint": "eslint",
    "paraglide:compile": "paraglide-js compile --project ./src/project.inlang --outdir ./src/paraglide --strategy custom-userSettings preferredLanguage baseLocale --emit-ts-declarations",
    "test": "pnpm run paraglide:compile && vitest run",
    "types": "pnpm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@inlang/paraglide-js": "^2.23.0",
    "@lucide/svelte": "^1.28.0",
    "@mozilla/readability": "^0.6.0",
    "svelte-spa-router": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.102.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
