{
  "name": "recueil",
  "version": "1.0.1",
  "type": "module",
  "description": "self-hosted webpage bookmarker and archiver",
  "homepage": "https://github.com/mfinelli/recueil",
  "author": "Mario Finelli",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "prettier --check .",
    "check:www": "pnpm exec prettier --plugin=prettier-plugin-jinja-template --parser=jinja-template --ignore-path '.gitignore' --check 'www/**/*.html'",
    "dev": "vite",
    "fmt": "prettier --write .",
    "fmt:www": "pnpm exec prettier --plugin=prettier-plugin-jinja-template --parser=jinja-template --ignore-path '.gitignore' --write 'www/**/*.html'",
    "lint": "eslint",
    "paraglide:compile": "paraglide-js compile --project ./src/project.inlang --outdir ./src/paraglide --strategy custom-userSettings preferredLanguage baseLocale --emit-ts-declarations",
    "test": "pnpm run paraglide:compile && vitest run",
    "types": "pnpm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@lucide/svelte": "^1.53.0",
    "@mozilla/readability": "^0.6.0",
    "svelte-spa-router": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/plugin-m-function-matcher": "^2.2.17",
    "@inlang/plugin-message-format": "^4.4.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
